+// N150 (8086:46d4) uses the Gen11+ 64-bit BDSM register at 0xC0.
+// Only this explicitly matched device bypasses the historical 00:02.0 guard.
+STATIC
+BOOLEAN
+IsN150 (
+  IN EFI_PCI_IO_PROTOCOL *PciIo
+  )
+{
+  UINT16 DeviceId;
+  EFI_STATUS Status;
+  Status = PciIo->Pci.Read (PciIo, EfiPciIoWidthUint16,
+                           PCI_DEVICE_ID_OFFSET, 1, &DeviceId);
+  return !EFI_ERROR (Status) && DeviceId == 0x46D4;
+}
+
+
 /**
   Allocate memory in the 32-bit address space, with the requested UEFI memory
   type and the requested alignment.
@@ -362,10 +378,12 @@
