+  BOOLEAN              N150;
 
   if (mBdsmSize == 0) {
     return EFI_INVALID_PARAMETER;
   }
+  N150 = IsN150 (PciIo);
   BdsmPages = EFI_SIZE_TO_PAGES (mBdsmSize);
 
   Status = Allocate32BitAlignedPagesWithType (
@@ -391,8 +409,8 @@
